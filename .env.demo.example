# =============================================================================
# JurisBPO — Variáveis de ambiente para o deploy de DEMONSTRAÇÃO
# =============================================================================
# Copie este arquivo para .env no projeto Vercel demo (não no projeto principal).
# Preencha com as credenciais do projeto Supabase criado exclusivamente para demo.
# NUNCA use as credenciais de produção aqui.
#
# Onde encontrar os valores:
#   Supabase → seu projeto demo → Settings → API
# =============================================================================

# --- Supabase (projeto demo) -------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO_DEMO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_do_projeto_demo

# Usada apenas pelo endpoint /api/push-email/run (server-side).
# Não é exposta ao frontend.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_do_projeto_demo

# --- Push de e-mail (IMAP) ---------------------------------------------------
# No ambiente demo o worker de e-mail não precisa rodar.
# Deixe estas variáveis vazias ou aponte para uma caixa de teste dedicada.

IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=

# UUID do escritório demo — gerado pelo seed_demo.sql
DEFAULT_ESCRITORIO_ID=a0000000-0000-0000-0000-000000000001

ALERT_WEBHOOK_URL=

# --- Proteção do cron -------------------------------------------------------
# Valor qualquer; o cron de push não precisa ser ativo na demo.
CRON_SECRET=demo_cron_secret_nao_usar_em_producao

# --- Identificação do ambiente (opcional) -----------------------------------
# Exibido no título da aba do navegador se configurado em appConfig.js
NEXT_PUBLIC_APP_ENV=demo
