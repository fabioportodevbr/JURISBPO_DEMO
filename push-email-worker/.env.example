# =============================================================================
# Andamentos processuais (Gmail IMAP)
# =============================================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=juridicocallbrbpo@gmail.com
# Use senha de app do Gmail, não a senha normal da conta
IMAP_PASSWORD=COLE_AQUI_A_SENHA_DE_APP_DO_GMAIL

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use SERVICE_ROLE apenas no servidor/worker. Nunca exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_SERVICE_ROLE_KEY

# Execução
POLL_INTERVAL_MINUTES=5
DEFAULT_ESCRITORIO_ID=COLE_AQUI_UUID_DO_ESCRITORIO_PADRAO

# Alertas opcionais
ALERT_EMAIL_ENABLED=false
ALERT_WEBHOOK_URL=

# =============================================================================
# Canal de Compliance
# As configurações IMAP e SMTP de compliance são gerenciadas pelo gerente
# diretamente na interface do sistema (módulo Compliance → Configurações).
# Não há variáveis de ambiente adicionais para o canal de compliance.
# =============================================================================
