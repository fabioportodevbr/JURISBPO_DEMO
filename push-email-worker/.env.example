# =============================================================================
# Andamentos processuais (Gmail IMAP)
# =============================================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=juridicocallbrbpo@gmail.com
# Use senha de app do Gmail, não a senha normal da conta
IMAP_PASSWORD=COLE_AQUI_A_SENHA_DE_APP_DO_GMAIL

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use SERVICE_ROLE apenas no servidor/worker. Nunca exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_SERVICE_ROLE_KEY

# Execução
POLL_INTERVAL_MINUTES=5
DEFAULT_ESCRITORIO_ID=COLE_AQUI_UUID_DO_ESCRITORIO_PADRAO

# Alertas opcionais
ALERT_EMAIL_ENABLED=false
ALERT_WEBHOOK_URL=

# =============================================================================
# Canal de Compliance (Exchange IMAP)
# Defina COMPLIANCE_IMAP_ENABLED=true para ativar o monitoramento.
# =============================================================================
COMPLIANCE_IMAP_ENABLED=false
COMPLIANCE_IMAP_HOST=mail.empresa.com
COMPLIANCE_IMAP_PORT=993
COMPLIANCE_IMAP_SECURE=true
COMPLIANCE_IMAP_USER=compliance@empresa.com
COMPLIANCE_IMAP_PASSWORD=COLE_AQUI_SENHA_DA_CAIXA_COMPLIANCE
# UUID do escritório ao qual as denúncias serão vinculadas (obrigatório se ENABLED=true)
COMPLIANCE_ESCRITORIO_ID=COLE_AQUI_UUID_DO_ESCRITORIO

# =============================================================================
# SMTP — envio de e-mails (auto-resposta ao denunciante + replies do officer)
# Pode ser o mesmo servidor Exchange da caixa de compliance.
# =============================================================================
SMTP_HOST=mail.empresa.com
SMTP_PORT=587
SMTP_SECURE=false
# false = STARTTLS na porta 587; true = SSL/TLS implícito na porta 465
SMTP_USER=compliance@empresa.com
SMTP_PASSWORD=COLE_AQUI_SENHA_SMTP
SMTP_FROM_NAME=Canal de Compliance
SMTP_FROM_EMAIL=compliance@empresa.com
