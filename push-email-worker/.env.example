# =============================================================================
# Andamentos processuais (Gmail IMAP)
# =============================================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=juridicocallbrbpo@gmail.com
# Use senha de app do Gmail, não a senha normal da conta
IMAP_PASSWORD=COLE_AQUI_A_SENHA_DE_APP_DO_GMAIL

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use SERVICE_ROLE apenas no servidor/worker. Nunca exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_SERVICE_ROLE_KEY

# Execução
POLL_INTERVAL_MINUTES=5
DEFAULT_ESCRITORIO_ID=COLE_AQUI_UUID_DO_ESCRITORIO_PADRAO

# Alertas opcionais
ALERT_EMAIL_ENABLED=false
ALERT_WEBHOOK_URL=

# =============================================================================
# Canal de Compliance
# As configuracoes IMAP e SMTP de compliance sao gerenciadas pelo gerente
# diretamente na interface do sistema (modulo Compliance -> Configuracoes).
# Nao ha variaveis de ambiente adicionais para o canal de compliance.
# =============================================================================

# =============================================================================
# WebService Publicacoes — Lider
# Habilite com LIDER_WS_ENABLED=true para buscar publicacoes do DJE via SOAP.
# O worker consulta getPublicacoesNaoExportadasV de hora em hora e marca como
# exportadas apos salvar com sucesso (setPublicacoes).
# =============================================================================
LIDER_WS_ENABLED=false
LIDER_WS_URL=http://201.48.5.17/WSPublicacoes/WSPublicacoes.asmx
LIDER_WS_NAMESPACE=http://tempuri.org/
LIDER_WS_VERSION=5
LIDER_LOGIN=SEU_LOGIN_LIDER
LIDER_SENHA=SUA_SENHA_LIDER
LIDER_GRUPO=0
