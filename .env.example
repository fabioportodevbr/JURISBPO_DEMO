# Copie este arquivo para .env e preencha com suas credenciais do Supabase
# Acesse: https://supabase.com → seu projeto → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Variaveis server-side usadas pela funcao /api/push-email/run
# Nao exponha a service role key no frontend.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=juridicocallbrbpo@gmail.com
IMAP_PASSWORD=sua_senha_de_app_do_gmail
DEFAULT_ESCRITORIO_ID=
ALERT_WEBHOOK_URL=

# Use CRON_SECRET na Vercel para proteger o cron.
CRON_SECRET=um_segredo_forte_para_o_cron
